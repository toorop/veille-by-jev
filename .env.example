# Names of the environment variables the pipeline expects.
# No values here: copy this file to .env and fill it in locally, or export the
# variables in your shell. .env is ignored by git and read at startup by the
# pipeline itself; a variable already exported always wins over the file.

# --- Triage (stage 3) ---
# TypeSafe key, from https://console.typesafe.ai/settings/keys.
# Nothing else is needed: the API base URL and the model name have working defaults
# (`https://api.typesafe.ai` and `jev-latest`). The SDK also honours
# TYPESAFE_BASE_URL, TYPESAFE_DEFAULT_MODEL and TYPESAFE_LOG_LEVEL if you ever need
# to override them.
TYPESAFE_API_KEY=

# --- Digest writing through a generative LLM (stage 4, not implemented yet) ---
WRITE_LLM_API_KEY=
# Identifier of the writing model, for example "mistral-large-latest".
WRITE_LLM_MODEL=
