# Noms des variables d'environnement attendues par le pipeline.
# Aucune valeur ici : recopier ce fichier en .env et renseigner localement.
# .env est ignoré par git.

# --- Triage TypeSafe / Jev (étape 3) ---
# Clé de la bêta TypeSafe, fournie par Stéphane.
TYPESAFE_API_KEY=
# Base de l'API TypeSafe, si elle diffère de la valeur par défaut du client.
TYPESAFE_BASE_URL=

# --- Rédaction du digest par un LLM génératif (étape 4) ---
WRITE_LLM_API_KEY=
# Identifiant du modèle de rédaction, par exemple "mistral-large-latest".
WRITE_LLM_MODEL=
