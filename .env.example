# Names of the environment variables the pipeline expects.
# No values here: copy this file to .env and fill it in locally.
# .env is ignored by git.

# --- TypeSafe / Jev triage (stage 3) ---
# TypeSafe beta key, provided by Stéphane.
TYPESAFE_API_KEY=
# TypeSafe API base URL, if it differs from the client default.
TYPESAFE_BASE_URL=

# --- Digest writing through a generative LLM (stage 4) ---
WRITE_LLM_API_KEY=
# Identifier of the writing model, for example "mistral-large-latest".
WRITE_LLM_MODEL=
